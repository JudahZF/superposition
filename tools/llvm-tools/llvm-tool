#!/bin/sh
# Resolve llvm-tools-preview from this repository's pinned Rustup toolchain.
# Cargo itself may come from another installation, so cargo-llvm-cov cannot infer
# the rustup sysroot that owns the matching LLVM tools.
set -eu

if [ "$#" -lt 1 ]; then
    printf '%s\n' "usage: $(basename "$0") <llvm-cov|llvm-profdata> [arguments...]" >&2
    exit 64
fi

tool_name=$1
shift
case "$tool_name" in
    llvm-cov|llvm-profdata) ;;
    *)
        printf '%s\n' "unsupported LLVM tool: $tool_name" >&2
        exit 64
        ;;
esac

script_directory=$(CDPATH= cd "$(dirname "$0")" && pwd)
workspace_root=$(CDPATH= cd "$script_directory/../.." && pwd)
toolchain_file="$workspace_root/rust-toolchain.toml"
toolchain=""
while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in
        channel\ =\ \"*\")
            toolchain=${line#*\"}
            toolchain=${toolchain%%\"*}
            break
            ;;
    esac
done < "$toolchain_file"

if [ -z "$toolchain" ]; then
    printf '%s\n' "could not read a pinned Rust toolchain from $toolchain_file" >&2
    exit 1
fi

host=""
while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in
        host:\ *)
            host=${line#host: }
            break
            ;;
    esac
done <<EOF
$(rustup run "$toolchain" rustc -vV)
EOF

if [ -z "$host" ]; then
    printf '%s\n' "could not determine Rustup host for $toolchain" >&2
    exit 1
fi

sysroot=$(rustup run "$toolchain" rustc --print sysroot)
tool_path="$sysroot/lib/rustlib/$host/bin/$tool_name"
if [ ! -x "$tool_path" ]; then
    printf '%s\n' "$tool_name is unavailable in Rustup toolchain $toolchain; install llvm-tools-preview for that toolchain" >&2
    exit 1
fi

exec "$tool_path" "$@"
