#!/bin/sh
# Delegate compilation to the Rustup toolchain pinned by this repository.
# This keeps Cargo's compiler sysroot and cargo-llvm-cov's LLVM-tool discovery
# aligned when the `cargo` executable itself comes from another installation.
set -eu

script_directory=$(CDPATH= cd "$(dirname "$0")" && pwd)
workspace_root=$(CDPATH= cd "$script_directory/../.." && pwd)
toolchain_file="$workspace_root/rust-toolchain.toml"
toolchain=""
while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in
        channel\ =\ \"*\")
            toolchain=${line#*\"}
            toolchain=${toolchain%%\"*}
            break
            ;;
    esac
done < "$toolchain_file"

if [ -z "$toolchain" ]; then
    printf '%s\n' "could not read a pinned Rust toolchain from $toolchain_file" >&2
    exit 1
fi

exec rustup run "$toolchain" rustc "$@"
